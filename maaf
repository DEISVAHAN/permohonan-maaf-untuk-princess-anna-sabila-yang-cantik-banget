<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permohonan Maaf untuk Princess Anna</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Great+Vibes&display=swap" rel="stylesheet">
    <style>
        .font-cursive {
            font-family: 'Great Vibes', cursive;
        }
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fbcfe8 0%, #f472b6 50%, #db2777 100%);
        }
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(5deg); }
        }
        .floating-heart {
            animation: float 4s ease-in-out infinite;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        .photobox-frame {
            border: 12px solid #f472b6;
            border-image: linear-gradient(to right, #ec4899, #f43f5e) 1;
            box-shadow: 0 10px 25px rgba(219, 39, 119, 0.3);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 overflow-x-hidden relative">

    <!-- Elemen Dekoratif Latar Belakang -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-10 left-10 text-pink-200 text-6xl opacity-40 floating-heart">🌸</div>
        <div class="absolute bottom-10 right-10 text-pink-200 text-7xl opacity-40 floating-heart" style="animation-delay: 2s;">💖</div>
        <div class="absolute top-1/3 right-1/4 text-pink-100 text-5xl opacity-30 floating-heart" style="animation-delay: 1s;">✨</div>
    </div>

    <!-- Elemen Audio untuk Lagu Sheila On 7 - Film Favorit -->
    <audio id="bgMusic" preload="auto">
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
        Browser Anda tidak mendukung elemen audio.
    </audio>

    <div class="max-w-md w-full glass-panel rounded-3xl shadow-2xl p-6 sm:p-8 text-center relative z-10 transition-all duration-500">
        
        <!-- Header / Ikon Mahkota -->
        <div class="mb-2">
            <span class="inline-block text-4xl mb-1 animate-bounce">👑</span>
            <span class="block text-xs uppercase tracking-widest text-pink-600 font-semibold">Special Apology</span>
        </div>

        <!-- Judul -->
        <h1 class="font-cursive text-4xl sm:text-5xl text-pink-700 mb-1">Princess Anna</h1>
        <p class="text-pink-800 font-medium text-sm sm:text-base mb-4">Yang Cantik Jelita & Paling Tersayang</p>

        <!-- Kartu Pesan -->
        <div id="mainContent">
            <div class="bg-pink-50/80 rounded-2xl p-5 mb-6 border border-pink-100 shadow-inner">
                <p id="apologyMessage" class="text-gray-700 leading-relaxed text-xs sm:text-sm">
                    "Duh, Yang Mulia Princess Anna... hamba mau minta maaf nih dari ujung rambut sampai ujung kaki atas kesalahan kemarin. Jangan ngambek lagi ya, cantik? Senyumanmu itu lho, bikin dunia rasanya kurang ceria kalau lagi cemberut. Maafin ya? 🥺"
                </p>
            </div>

            <!-- Tombol Interaktif -->
            <div class="space-y-3">
                <button id="forgiveBtn" onclick="acceptApology()" class="w-full bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-semibold py-3 px-6 rounded-xl shadow-lg transform transition active:scale-95 text-sm">
                    💖 Dimaafin deh, Yuk Baikan!
                </button>
                
                <div class="relative h-12 flex justify-center items-center">
                    <button id="thinkBtn" onmouseover="moveButton()" onclick="moveButton()" class="bg-white hover:bg-pink-50 text-pink-600 border border-pink-300 font-medium py-2 px-5 rounded-xl shadow-sm transition absolute text-sm">
                        Masih Ngambek 😤
                    </button>
                </div>
            </div>
        </div>

        <!-- Area Photobox & Kamera (Tersembunyi Awalnya) -->
        <div id="successArea" class="hidden mt-2 animate-fade-in">
            <h3 class="font-bold text-base text-pink-700 mb-1">Selfie dulu yuk 📸</h3>
            <p class="text-xs text-pink-600 mb-3">biar ketauan kalo udahh ga badmood lagi ✨</p>
            
            <!-- Photobox Container -->
            <div id="photoboxContainer" class="bg-white p-3 rounded-2xl photobox-frame relative mb-4 overflow-hidden">
                <div id="cameraWrapper" class="relative rounded-lg overflow-hidden bg-black aspect-[3/4] flex items-center justify-center">
                    <video id="webcam" autoplay playsinline class="w-full h-full object-cover transform -scale-x-100"></video>
                    <canvas id="snapshotCanvas" class="hidden w-full h-full object-cover"></canvas>
                </div>
                <!-- Stiker Photobox -->
                <div class="absolute top-5 left-5 bg-pink-500/80 text-white text-[10px] px-2 py-0.5 rounded-full font-bold">Anna & You 👑</div>
            </div>

            <!-- Tombol Aksi Kamera & WhatsApp -->
            <div class="space-y-2">
                <button id="captureBtn" onclick="takeSnapshot()" class="w-full bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md text-sm transition">
                    ✨ Ambil Foto (Snap!)
                </button>
                <button id="retakeBtn" onclick="retakePhoto()" class="hidden w-full bg-white text-pink-600 border border-pink-300 font-semibold py-2 px-4 rounded-xl shadow-sm text-sm transition hover:bg-pink-50">
                    🔄 Foto Ulang
                </button>
                <button id="sendWaBtn" onclick="sendToWhatsApp()" class="hidden w-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md text-sm transition flex items-center justify-center space-x-2">
                    <span>📲 Kirim ke WhatsApp (085786243667)</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Skrip JavaScript untuk Interaksi, Kamera, dan Audio -->
    <script>
        let stream = null;
        let photoTaken = false;

        async function acceptApology() {
            document.getElementById('mainContent').style.display = 'none';
            const successArea = document.getElementById('successArea');
            successArea.classList.remove('hidden');

            // Memutar musik saat tombol diklik
            const music = document.getElementById('bgMusic');
            music.play().catch(error => {
                console.log("Pemutaran audio dicegah oleh browser:", error);
            });

            // Aktifkan kamera web
            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
                const videoElement = document.getElementById('webcam');
                videoElement.srcObject = stream;
            } catch (err) {
                console.error("Gagal mengakses kamera:", err);
                alert("Tidak dapat mengakses kamera. Pastikan izin kamera telah diberikan.");
            }

            // Efek partikel emoji seru
            for (let i = 0; i < 15; i++) {
                createParticle();
            }
        }

        function takeSnapshot() {
            const video = document.getElementById('webcam');
            const canvas = document.getElementById('snapshotCanvas');
            const context = canvas.getContext('2d');

            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;

            context.save();
            context.scale(-1, 1);
            context.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);
            context.restore();

            video.classList.add('hidden');
            canvas.classList.remove('hidden');

            // Hentikan stream kamera setelah foto diambil
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
            }

            photoTaken = true;
            document.getElementById('captureBtn').classList.add('hidden');
            document.getElementById('retakeBtn').classList.remove('hidden');
            document.getElementById('sendWaBtn').classList.remove('hidden');
        }

        async function retakePhoto() {
            const video = document.getElementById('webcam');
            const canvas = document.getElementById('snapshotCanvas');

            canvas.classList.add('hidden');
            video.classList.remove('hidden');

            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
                video.srcObject = stream;
            } catch (err) {
                console.error("Gagal menyalakan ulang kamera:", err);
            }

            photoTaken = false;
            document.getElementById('captureBtn').classList.remove('hidden');
            document.getElementById('retakeBtn').classList.add('hidden');
            document.getElementById('sendWaBtn').classList.add('hidden');
        }

        function sendToWhatsApp() {
            const phoneNumber = "6285786243667";
            const message = encodeURIComponent("Hai Princess Anna! Nih foto selfie terbaru biar tau kalau aku udah gak badmood lagi. Maafin aku ya! 💖✨");
            const waUrl = `https://wa.me/${phoneNumber}?text=${message}`;
            window.open(waUrl, '_blank');
        }

        function moveButton() {
            const btn = document.getElementById('thinkBtn');
            const x = Math.random() * 200 - 100;
            const y = Math.random() * 80 - 40;
            btn.style.transform = `translate(${x}px, ${y}px)`;
        }

        function createParticle() {
            const particle = document.createElement('div');
            particle.innerHTML = ['🌸', '💖', '✨', '🌷', '🥰'][Math.floor(Math.random() * 5)];
            particle.style.position = 'fixed';
            particle.style.left = Math.random() * window.innerWidth + 'px';
            particle.style.top = Math.random() * window.innerHeight + 'px';
            particle.style.fontSize = (Math.random() * 20 + 15) + 'px';
            particle.style.transition = 'all 1s ease-out';
            particle.style.zIndex = '999';
            document.body.appendChild(particle);

            setTimeout(() => {
                particle.style.transform = `translateY(-120px) scale(1.5)`;
                particle.style.opacity = '0';
            }, 50);

            setTimeout(() => {
                particle.remove();
            }, 1050);
        }
    </script>
</body>
</html>